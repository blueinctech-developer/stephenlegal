# Copy to .env.local for local development. In production, set these in the
# hosting dashboard (Vercel → Project → Settings → Environment Variables),
# never in a committed file.

# Postgres database holding all content, accounts and messages.
# Local: run `npm run db:local` and use the line below.
# Production: the connection string from the database provider (e.g. Neon).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Public address of the site (canonicals, sitemap, feed). Anything other than
# https://stephenlegal.ng is kept out of search engines.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lets the first administrator be created at /admin/setup/ (only works while
# no accounts exist). A random code of 16+ characters; remove it afterwards.
ADMIN_SETUP_TOKEN=

# Uploaded images and PDFs in production (Vercel → Storage → Blob). Leave empty
# locally: files are then kept in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Contact and contributor forms are emailed through the publication's own
# mailbox (hosting control panel → Email Accounts → Connect Devices).
# Messages are also kept in the admin under Messages, so these are optional.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: where form messages go (default info@stephenlegal.ng) and the
# sender address (default SMTP_USER).
FORM_TO=
FORM_FROM=

# Only for `npm run import:wordpress`: the WordPress site to copy content from.
WORDPRESS_URL=https://stephenlegal.ng
