# Copy to .env.local for local development. In production, set these in the
# hosting dashboard (Vercel → Project → Settings → Environment Variables),
# never in a committed file.

# Postgres database holding all content, accounts and messages.
# Local: run `npm run db:local` and use the line below.
# Production: the connection string from the database provider (e.g. Neon).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Public address of the site (canonicals, sitemap, feed). Anything other than
# https://stephenlegal.ng is kept out of search engines.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lets the first administrator be created at /admin/setup/ (only works while
# no accounts exist). A random code of 16+ characters; remove it afterwards.
ADMIN_SETUP_TOKEN=

# Uploaded images and PDFs in production: a public Amazon S3 bucket (as on
# lexpraxis). The same access key also sends email through SES (see below).
# Leave empty locally: files are then kept in .data/uploads.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
# Optional: the public address files are served from (default: the bucket's own,
# https://<bucket>.s3.<region>.amazonaws.com), e.g. a CloudFront address.
NEXT_PUBLIC_MEDIA_URL=
# Before the move to S3, files were on Vercel Blob (BLOB_STORE_ID, added by
# connecting a Blob store in Vercel). Still used for files not yet moved.
BLOB_STORE_ID=

# Form notifications and the Contact form's automatic reply. Messages are also
# kept in the admin under Messages, so email is optional.
# Amazon SES (used when region and key are set): an IAM access key allowed
# ses:SendEmail, in the region where stephenlegal.ng is a verified identity.
# Leave these empty to use the S3_* key and region below for SES too.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional SES configuration set (bounce/complaint tracking).
SES_CONFIGURATION_SET=
# Or, without SES: a mailbox's SMTP settings
# (hosting control panel → Email Accounts → Connect Devices).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: where form messages go (default info@stephenlegal.ng) and the
# sender address (default no-reply@stephenlegal.ng with SES, SMTP_USER with SMTP).
FORM_TO=
FORM_FROM=

# Only for `npm run import:wordpress`: the WordPress site to copy content from.
WORDPRESS_URL=https://stephenlegal.ng
