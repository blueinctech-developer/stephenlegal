# Where WordPress (the CMS) is served. Today: the live site. After launch,
# move WordPress to a subdomain such as https://cms.stephenlegal.ng.
WORDPRESS_URL=https://stephenlegal.ng

# Public URL of this Next.js site (canonicals, sitemap, feed).
NEXT_PUBLIC_SITE_URL=https://stephenlegal.ng

# Shared secret for POST /api/revalidate (WordPress calls it after publishing).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Contact and contributor forms send email through the publication's own
# mailbox. Take these from the hosting control panel (Email Accounts →
# Connect Devices). Set them in the hosting dashboard, never in this file.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: where form messages go (default info@stephenlegal.ng) and the
# sender address (default SMTP_USER).
FORM_TO=
FORM_FROM=
