# Where WordPress (the CMS) is served. Today: the live site. After launch,
# move WordPress to a subdomain such as https://cms.stephenlegal.ng.
WORDPRESS_URL=https://stephenlegal.ng

# Public URL of this Next.js site (canonicals, sitemap, feed).
NEXT_PUBLIC_SITE_URL=https://stephenlegal.ng

# Shared secret for POST /api/revalidate (WordPress calls it after publishing).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
